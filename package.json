{
  "name": "ag-form-builder",
  "version": "0.0.3-beta.20",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:lib && npm run build:demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "build:lib": "npm run copy:readme && ng build ag-form-builder",
    "build:demo": "NODE_ENV=production ng build ag-form-builder-demo",
    "publish:demo": "npx angular-cli-ghpages --dir=./dist/ag-form-builder-demo",
    "publish:lib": "npx semantic-release",
    "copy:readme": "copyfiles ./README.md ./dist/ag-form-builder",
    "semantic-release": "semantic-release"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.4",
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/material": "~22.2.5",
    "@angular/platform-browser": "~22.2.4",
    "@angular/platform-browser-dynamic": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^10.14.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.6.6",
    "copyfiles": "^2.4.1",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "~22.2.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "semantic-release": "^25.0.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hossein13m/angular-form-builder.git"
  },
  "description": "AG-FormBuilder is an Angular library for creating dynamic forms and interacting with them.",
  "keywords": [
    "javaScript",
    "typeScript",
    "angular"
  ],
  "author": "Hossein Mousavi <dev.hosseinmousavi@gmail.com> (https://hossein.dev/)",
  "contributors": [
    "Joe <joe@whatever.com> (https://whatever.com)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hossein13m/angular-form-builder/issues"
  },
  "homepage": "https://www.ag-form-builder.hossein.dev/"
}
